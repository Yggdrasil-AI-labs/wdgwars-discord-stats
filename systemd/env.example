# Copy to ~/.config/wdgwars-discord-stats/env and chmod 600.
# These are secrets. Do not commit this file with real values.

# Your WDGoWars API key (https://wdgwars.pl/profile)
WDGWARS_API_KEY=your-64-char-key

# Your Discord bot token (Developer Portal). The bot needs Manage Channels.
DISCORD_BOT_TOKEN=your-bot-token

# Your Discord server (guild) id.
DISCORD_GUILD_ID=000000000000000000

# Optional overrides:
# STATS_CATEGORY_NAME=📊 │ live stats
# STATS_INTERVAL=300
# STATS_TZ=America/New_York
# STATS_OWNER_USERNAME=YourName
