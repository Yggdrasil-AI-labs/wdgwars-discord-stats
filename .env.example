# Copy this file to ".env" (same folder as live_stats_channels.py) and fill it
# in. .env is gitignored, so your secrets stay on your machine. Do not commit
# real values.

WDGWARS_API_KEY=your-64-char-key
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=000000000000000000

# Optional overrides:
# STATS_CATEGORY_NAME=📊 │ live stats   # the single category all stat channels live in
# STATS_INTERVAL=300
# STATS_TZ=America/New_York
# STATS_OWNER_USERNAME=YourName

# --- discord_stats_webhook.py / war_feed.py (webhook post target) ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- war_feed.py (event alerts) ---
# War feed can post via the webhook above, or via the bot token + a channel id:
# WARFEED_CHANNEL_ID=000000000000000000
# WARFEED_ALERTS=captures,losses,rigs   # which alerts fire (default: all)
# WARFEED_RIG_STALE_HOURS=12            # rig-down threshold
# WARFEED_INTERVAL=300
# WARFEED_TZ=America/New_York
